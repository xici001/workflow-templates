{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "文献综述输入契约",
  "type": "object",
  "required": ["topic", "papers"],
  "properties": {
    "topic": { "type": "string", "description": "综述主题" },
    "papers": {
      "type": "array",
      "minItems": 3,
      "description": "文献列表（标题+摘要，建议 3-10 篇）",
      "items": {
        "type": "object",
        "required": ["title", "abstract"],
        "properties": {
          "title": { "type": "string", "description": "文献标题" },
          "abstract": { "type": "string", "description": "摘要或核心内容（150 字以上效果更好）" },
          "year": { "type": ["integer", "null"], "description": "发表年份（可选）" },
          "venue": { "type": ["string", "null"], "description": "期刊/会议（可选）" }
        }
      }
    },
    "style": { "type": "string", "enum": ["academic", "industry"], "default": "academic", "description": "学术风格或产业风格" },
    "section_count": { "type": "integer", "minimum": 2, "maximum": 6, "default": 3, "description": "正文分节数（建议 2-4）" }
  }
}
